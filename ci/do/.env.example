# Local config for deploy.sh — copy to .env (gitignored) and fill in.
# Keeps infrastructure names out of the tracked, public code.
# In CI these come from GitHub repository Variables (DO_REGION, SPACES_BUCKET)
# and Secrets (DO_SPACES_ACCESS_KEY, DO_SPACES_SECRET_KEY, DIGITALOCEAN_ACCESS_TOKEN).

# DigitalOcean auth: a named doctl context, or export DIGITALOCEAN_ACCESS_TOKEN.
DO_CONTEXT=your-doctl-context

# Droplet + Spaces region (e.g. ams3, nyc3, sfo3).
REGION=your-region

# Spaces bucket for build artifacts and caches.
SPACES_BUCKET=your-bucket

# Spaces keys (leave empty to skip upload/caching).
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
